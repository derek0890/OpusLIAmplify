# A Postgres connection string — required, including for local dev. SQLite
# doesn't work on serverless hosts (Vercel, Render, etc. all have ephemeral
# filesystems), so the schema is set to postgresql by default. A free local
# option: https://neon.com (generous free tier, scale-to-zero).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
AUTH_SECRET="generate-a-random-string-for-production"
# Required for AI copy generation. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
# Optional — override the models used by each AI agent (see README).
OPENAI_RESEARCH_MODEL="gpt-5.4-nano"
OPENAI_COPY_MODEL="gpt-5.5"

# --- Enterprise SSO (optional — see README "Deploying for a company's SSO") ---
# Leave all three unset to keep email/password login only.
# SSO_ISSUER="https://your-company.okta.com"
# SSO_CLIENT_ID="..."
# SSO_CLIENT_SECRET="..."
# SSO_PROVIDER_NAME="Okta"
# Comma-separated emails auto-granted ADMIN on their first login (SSO or password).
# INITIAL_ADMIN_EMAILS="admin@your-company.com"
# Set to "true" to hide the email/password form once SSO is confirmed working.
# DISABLE_PASSWORD_LOGIN="false"
# Optional — auto-fills each employee's job title/department from the IdP on
# sign-in, used to tailor AI copy to their role (see README "Employee
# designations"). Works automatically with Microsoft (no setup beyond SSO
# itself). For Google Workspace, also needs a Workspace admin's email here —
# domain-wide delegation requires impersonating an actual admin, reusing the
# same GOOGLE_CLIENT_EMAIL/GOOGLE_PRIVATE_KEY service account as the Google
# Workspace notification channel below (needs the
# https://www.googleapis.com/auth/admin.directory.user.readonly scope added
# to its domain-wide delegation).
# GOOGLE_DIRECTORY_ADMIN_EMAIL="admin@your-company.com"

# --- Whitebox instance provisioning (/admin/super) ---
# Only the address set here can open /admin/super, which generates other
# companies' notification/AI credentials as a downloadable .env file.
# Leave this UNSET on every client deployment — set it only on your own
# internal copy of the app. Defaults to derekfrancis.14@gmail.com if unset.
# SUPER_ADMIN_EMAIL="derekfrancis.14@gmail.com"

# --- Post-publish notifications (optional — see README "Notifications") ---
# Leave a channel's vars unset to skip it entirely for this deployment.
# This app's own URL, used to build the "Amplify it" link in notifications.
# APP_URL="https://relay.your-company.com"

# Slack — recommended: a bot token lets the app create (or reuse) the
# channel itself and post into it directly. Create a Slack app at
# https://api.slack.com/apps, add the channels:manage and chat:write bot
# scopes, install it to the workspace, and use its Bot User OAuth Token.
# SLACK_BOT_TOKEN="xoxb-..."
# SLACK_CHANNEL_NAME="relay-notifications"
# Slack — simpler alternative: an Incoming Webhook tied to a channel an
# admin already created by hand (no auto-create, no bot scopes needed).
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Microsoft Teams — recommended: lets the app create (or reuse) the channel
# and post real channel messages. Microsoft Graph has no app-only
# credential for posting a channel message, so this authenticates as a
# real signed-in service account instead (see README "Notifications").
# Register an Entra app with a client secret, grant it the DELEGATED
# permissions Channel.Create and ChannelMessage.Send (admin consent), add
# this app's redirect URI (${APP_URL}/api/integrations/teams/callback),
# add the service account to the target team, then connect it from
# /admin/integrations.
# TEAMS_CLIENT_ID="..."
# TEAMS_CLIENT_SECRET="..."
# TEAMS_TENANT_ID="..."
# TEAMS_TEAM_ID="..."
# TEAMS_CHANNEL_NAME="relay-notifications"
# Microsoft Teams — simpler alternative: a Power Automate flow webhook
# built from the "Post to a channel when a webhook request is received"
# template, wired to a channel an admin already created by hand.
# TEAMS_WEBHOOK_URL="https://..."

# Exchange / Outlook (Microsoft Graph, app-only auth): register an Entra app,
# grant it the Mail.Send *application* permission with admin consent, and
# create a client secret.
# EXCHANGE_TENANT_ID="..."
# EXCHANGE_CLIENT_ID="..."
# EXCHANGE_CLIENT_SECRET="..."
# EXCHANGE_SENDER_EMAIL="notifications@your-company.com"
# EXCHANGE_NOTIFY_RECIPIENTS="admin1@your-company.com,admin2@your-company.com"

# Google Workspace Email (Gmail API, service account + domain-wide
# delegation): create a service account, enable the Gmail API, and
# authorize its client ID for the https://www.googleapis.com/auth/gmail.send
# scope in the Workspace Admin console.
# GOOGLE_CLIENT_EMAIL="svc@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_WORKSPACE_SENDER_EMAIL="notifications@your-company.com"
# GOOGLE_WORKSPACE_NOTIFY_RECIPIENTS="admin@your-company.com"
