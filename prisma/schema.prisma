generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CopyType {
  REPOST
  COMMENT
}

enum MediaType {
  NONE
  IMAGE
  CAROUSEL
  VIDEO
  DOCUMENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  // Null for users provisioned via SSO, who never set a password.
  passwordHash  String?
  role          Role      @default(EMPLOYEE)
  // Revokes access without losing the account/history, distinct from role.
  isActive      Boolean   @default(true)
  // Required by the Auth.js adapter contract; unused by our own OIDC flow
  // since we treat the IdP as the source of truth for verification.
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  posts             Post[]             @relation("PostAuthor")
  amplifiedCopies   AmplifiedCopy[]
  styleGuideEdits   StyleGuide[]
  accounts          Account[]
  sessions          Session[]
  teamsIntegrations TeamsIntegration[]
  createdInstances  WhiteboxInstance[]
}

// Auth.js Prisma adapter contract (links an SSO identity to a User).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Unused while session.strategy is "jwt", but required by the adapter's
// expected schema shape — keeps the door open to switch to database
// sessions later without another migration.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A generated configuration bundle for one client company's own whitebox
// deployment (see /admin/super). This app itself stays single-tenant —
// this just assembles and remembers the .env values for a SEPARATE
// deployment of the same codebase, which an admin then stands up by hand
// following the playbook. Secrets live here in plaintext like everywhere
// else in this project's env-var-based config; the /admin/super pages are
// restricted to SUPER_ADMIN_EMAIL precisely because of what this holds.
model WhiteboxInstance {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?

  slackBotToken    String?
  slackChannelName String?
  slackWebhookUrl  String?

  teamsClientId     String?
  teamsClientSecret String?
  teamsTenantId     String?
  teamsTeamId       String?
  teamsChannelName  String?
  teamsWebhookUrl   String?

  exchangeTenantId         String?
  exchangeClientId         String?
  exchangeClientSecret     String?
  exchangeSenderEmail      String?
  exchangeNotifyRecipients String?

  googleClientEmail               String?
  googlePrivateKey                String?
  googleWorkspaceSenderEmail      String?
  googleWorkspaceNotifyRecipients String?

  openaiApiKey        String?
  openaiResearchModel String?
  openaiCopyModel     String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Holds the delegated OAuth tokens for the Teams notification channel's
// service account (see src/lib/integrations/teams-token.ts). Singleton —
// at most one row ever exists. Posting a Teams channel message requires a
// signed-in user's delegated permissions; Microsoft Graph has no app-only
// permission for it outside data-migration scenarios.
model TeamsIntegration {
  id            String    @id @default(cuid())
  refreshToken  String
  accessToken   String?
  expiresAt     DateTime?
  channelId     String?
  connectedById String
  connectedBy   User      @relation(fields: [connectedById], references: [id])
  updatedAt     DateTime  @updatedAt
}

model Post {
  id               String     @id @default(cuid())
  caption          String
  postUrl          String
  mediaType        MediaType  @default(NONE)
  mediaJson        String     @default("[]")
  linksJson        String     @default("[]")
  contextLinksJson String     @default("[]")
  contextBrief     String?
  status           PostStatus @default(DRAFT)
  createdById      String
  createdBy        User       @relation("PostAuthor", fields: [createdById], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  amplifiedCopies AmplifiedCopy[]
}

model StyleGuide {
  id          String   @id @default(cuid())
  content     String
  updatedAt   DateTime @updatedAt
  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
}

model AmplifiedCopy {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      CopyType
  content   String
  createdAt DateTime @default(now())

  @@index([postId, userId])
}
